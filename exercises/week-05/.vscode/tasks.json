{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang.exe build active file",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Tools\\Llvm\\x64\\bin\\clang++.exe",
            "args": [
                "-std=c++17",
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${fileDirname}\\tester_1.cpp",
                "${fileDirname}\\mailServer.cpp",
                "${fileDirname}\\spamFilterPlugin.cpp",
                "${fileDirname}\\verifyIdentityPlugin.cpp",
                "-o",
                "${fileDirname}\\ws.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Build and Run",
            "type": "shell",
            "windows": {
                "command": "& 'C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Tools\\Llvm\\x64\\bin\\clang++.exe' -std=c++17 -Wall tester_1.cpp mailServer.cpp spamFilterPlugin.cpp verifyIdentityPlugin.cpp -o ws.exe; .\\ws.exe emails.csv identities.txt spam.txt"
            },
            "osx": {
                "command": "clang++ -arch arm64 -std=c++17 -Wall -g tester_1.cpp mailServer.cpp spamFilterPlugin.cpp verifyIdentityPlugin.cpp -o ws && ./ws emails.csv identities.txt spam.txt"
            },
            "linux": {
                "command": "g++ -std=c++17 -Wall -g tester_1.cpp mailServer.cpp spamFilterPlugin.cpp verifyIdentityPlugin.cpp -o ws && ./ws emails.csv identities.txt spam.txt"
            },
            "options": {
                "cwd": "${workspaceFolder}/exercise-01/release"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}